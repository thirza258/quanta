{
  "name": "quanta-lms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:api": "backend/.venv/bin/python -m uvicorn quanta.main:app --app-dir backend --reload --host 127.0.0.1 --port 8000",
    "setup": "npm install && python3 -m venv backend/.venv && backend/.venv/bin/python -m pip install -r backend/requirements.txt",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:api": "backend/.venv/bin/python -m pytest backend/tests -q",
    "check": "npm run build && npm test && npm run test:api",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,yaml,html}\" \"scripts/*.mjs\" \"e2e/*.ts\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "katex": "^0.16.22",
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.0.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
