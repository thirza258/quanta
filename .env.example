# Docker defaults bind only to the local machine.
BIND_ADDRESS=127.0.0.1
PORT=8080
POSTGRES_PASSWORD=quanta-local-change-me
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
# For a public HTTPS deployment, set a strong alphanumeric database password,
# set ALLOWED_ORIGINS to the exact HTTPS origin, and COOKIE_SECURE=true.
# Place a TLS reverse proxy in front; expose only the web service.
# Optional, otherwise generated in the persistent API volume:
# JWT_SECRET=at-least-32-cryptographically-random-characters

# Optional: the commit recorded in research-run provenance. The Docker image has no
# .git directory; set the hash here, or in the shell at deploy time:
#   QUANTA_GIT_COMMIT=$(git rev-parse HEAD) docker compose up -d
QUANTA_GIT_COMMIT=

# Optional course AI assistant. Keys stay in the API; never use a VITE_ prefix.
# Choose openrouter (default when OPENROUTER_API_KEY is set) or firebase.
AI_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Firebase AI Logic provider (used when AI_PROVIDER=firebase).
# The Firebase web API key is a project identifier, but keep it server-side.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_MODEL=gemini-2.5-flash
# Optional: set a location to use the Agent Platform/Vertex backend.
FIREBASE_LOCATION=
# Optional: required only when Firebase App Check enforcement is enabled.
FIREBASE_APP_CHECK_TOKEN=
# Optional: a short-lived Firebase ID token, sent as Authorization: Firebase ...
FIREBASE_ID_TOKEN=
