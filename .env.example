# Docker defaults bind only to the local machine.
BIND_ADDRESS=127.0.0.1
PORT=8080
POSTGRES_PASSWORD=quanta-local-change-me
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
# For a public HTTPS deployment, set a strong alphanumeric database password,
# set ALLOWED_ORIGINS to the exact HTTPS origin, and COOKIE_SECURE=true.
# Place a TLS reverse proxy in front; expose only the web service.
# Optional, otherwise generated in the persistent API volume:
# JWT_SECRET=at-least-32-cryptographically-random-characters

# Optional course AI assistant. Keys stay in the API; never use a VITE_ prefix.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
